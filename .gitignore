# The live wildfire mirror is written on the server by pipeline/live.py every ten
# minutes. It is deployment state, not source: committing it would ship stale fire
# data over a fresh mirror on every deploy.
/data/live/*
!/data/live/README.md

# Generated raster exports of the 3D figures (regenerate: make figures).
/3d/assets/raster/*
!/3d/assets/raster/.gitignore

__pycache__/
*.pyc
.DS_Store

# Disposable Chromium profiles and probes; remove after an interrupted check.
/.browser-scratch/

# Local agent tooling settings. They name paths on one machine and are never tracked.
/.claude/

# LaTeX intermediates. The PDFs themselves ARE committed — they are the artefact people are
# sent — but the .aux/.log/.fls churn on every build and nobody reads them.
/research/pdf/out/*
!/research/pdf/out/*.pdf
/research/pdf/*.body.tex
/research/pdf/0*.tex
/research/pdf/figures.tex
# Vision-review captures: hundreds of PNGs per run, regenerated by tools/joint_shots.py.
# The verdicts beside them are small and ARE committed.
/research/geometry/nodes/vision/shots/
