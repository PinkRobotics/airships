# Whitespace conventions, so that a contributor's editor does not reformat a file on save
# and bury a one-line change in a hundred-line diff. These describe what the repository
# already contains; they are not a new style anyone has to learn.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[Makefile]
# make requires a literal tab before every recipe line. Spaces are a syntax error.
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown. Stripping them silently rewraps prose.
trim_trailing_whitespace = false

[*.{json,geojson}]
# data/*.json is generated by pipeline/. Reformatting it produces a large diff of a file
# nobody edits by hand, and the next regeneration undoes it.
insert_final_newline = false
trim_trailing_whitespace = false
