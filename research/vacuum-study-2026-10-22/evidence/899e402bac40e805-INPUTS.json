  "formulas": {
    "leak_budget": "lift_1pct = 0.01*lift; p_int = 0.01*p_ext (isothermal same gas); Q = V*p_int/86400",
    "choked_aperture": "flux = p*sqrt(gamma/(R T))*(2/(gamma+1))^((gamma+1)/(2(gamma-1))); A = m_dot/flux",
    "molecular_aperture": "Q = (1/4)*p*vbar*A; vbar = sqrt(8 R_air T / pi)",
    "permeation": "n_dot = permeance * A * dp; scc = 1/22414 mol",
    "outgas_moisture": "p = m_water * R_v * T / V",
    "pump": "W_ideal = Q*ln(p_out/p_in); pump-down energy = p0*V*ln(p0/p1)",
    "seams": "L = 2A/w; mass = L*(b*tf*rho_SiC + b*t_adh*rho_adh + tc*t_splice*rho_paste)",
    "thermal_balance": "alpha*S*pi*R^2 = eps*sigma*(T^4 - T_env^4)*4 pi R^2 + h*(T - T_air)*4 pi R^2, T_env = (T_sky + T_air)/2",
    "core_tau": "tau = tc^2/(pi^2 * a); a = k/(rho*cp)",
    "cte_shear_lag": "lambda = sqrt(Gc/(E_f tf tc)); tau_max = (alpha_core - alpha_face)*dT*E_f*tf*lambda",
    "thermal_imperfection": "w = alpha_face * dT_vertical * R / 2",
    "gust": "q = 0.5 rho v^2; F = Cd q pi R^2 * gust_factor; patch p = F/A_patch",
    "climate": "rho = p/(R_air T); dL/L = dp/p - dT/T"
  }
