      "finding": "SR-200-E sheet column gives tensile properties, not an in-plane compression minimum.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": false
    },
    {
      "source": "doe-ingot",
      "location": "PDF pp.29-32",
      "finding": "Thin rolled .025 inch material tested at .021 inch after .004 inch total etch; the reported tests are tensile.",
      "tag": "QUESTIONABLE",
