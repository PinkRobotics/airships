      "table_image_inspected": true
    },
    {
      "source": "mmpds08",
      "location": "PDF pp.275-279 / printed pp.7-3 to 7-7",
      "finding": "Sheet Fcy blank; E and Ec=42.5 Msi and nu=.10. 42/48 ksi Fcy in adjacent table applies to AMS7908 HIP preforms. Finishing guidance does not justify double etching stock.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": true
    },
    {
      "source": "sr200_lot",
      "location": "PDF p.22 / printed p.9, PDF pp.99-104 / printed pp.86-91",
      "finding": "379.2/382.7 MPa L/LT compression yield reproduced from Fenn 1967 at 1.96 mm; report own two-specimen compression section reports ultimate failure 658.8/691.8 MPa. No target-gauge minimum established.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": true
    },
    {
      "source": "nasa4397",
      "location": "PDF pp.13,16,25 / printed pp.5,8,17",
      "finding": "50/57.5 ksi compression input, unpublished attribution, missing biaxial yield replaced by failure in fitted criterion. Polynomial root 330.743347543 MPa verified; equal-compression qualification absent.",
      "tag": "PROJECTION",
      "table_image_inspected": true
    },
    {
      "source": "materion-design",
      "location": "PDF/printed pp.4,8",
      "finding": "Generic typical compression discussion and approximate S-200-F 255 MPa; sheet section separately lists tensile minimum. No universal compression uplift or thin-sheet lower bound.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": true
    },
    {
      "source": "ps200",
      "location": "Catalog thickness and properties tables",
      "finding": "Relevant nominal .032 inch/0.8 mm option; no matched Fcy or Fty listed.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": false
    },
    {
      "source": "pf60",
      "location": "Catalog thickness and properties tables",
      "finding": "Relevant nominal .032 inch/0.8 mm option; gauge and vacuum-integrity specifications do not supply a compression allowable.",
      "tag": "QUESTIONABLE",
      "table_image_inspected": false
    },
    {
      "source": "doe-specs",
